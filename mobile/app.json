{
  "expo": {
    "name": "MistikAI",
    "slug": "mistikai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0014"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mistikai.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Avuç izi ve yüz fotoğrafınızı analiz etmek için galeri erişimi gereklidir.",
        "NSCameraUsageDescription": "Fotoğraf çekmek için kamera erişimi gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0014"
      },
      "package": "com.mistikai.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Avuç izi ve yüz fotoğrafınızı analiz etmek için galeri erişimi gereklidir."
        }
      ]
    ],
    "scheme": "mistikai",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "mistikai"
      }
    }
  }
}
